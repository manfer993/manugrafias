rules_version = '2';

// The AR experience only reads one photographer document. The content panel (repository manugrafias_admin)
// writes as the administrator: a Google sign-in of project manugrafias-2026 with the custom claim admin: true.
// New sign-ups are disabled in Firebase Authentication, so no other account can exist.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.admin == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // Public: one photographer document by its slug. Only the administrator can list and write.
    // Photographers can be created and edited, never deleted (SRS 1.2).
    match /photographers/{slug} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Panel-only data (titles, upload dates, source files). Never readable by end users.
    match /artworks/{artworkId} {
      allow read, write: if isAdmin();
    }
  }
}
